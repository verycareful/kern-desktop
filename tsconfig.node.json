{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "target": "ES2022",
    "strict": true,
    "noEmit": false,
    "emitDeclarationOnly": true,
    "outDir": "node_modules/.tmp/tsconfig-node",
    "types": ["node"]
  },
  // vitest.config.ts is left out: vitest 3 bundles vite 7, whose plugin types
  // do not match the vite 8 types @vitejs/plugin-react is built against.
  "include": ["vite.config.ts", "playwright.config.ts"]
}
