# Desktop Entry Specification 1.5. The MimeType line is the output of
# `cargo run --example desktop_mime_types` (src-tauri/examples).
[Desktop Entry]
Type=Application
Name=Kern
GenericName=File Manager
Comment=Browse, organise and edit your files
Keywords=files;folders;text;editor;
Categories=System;Utility;FileTools;FileManager;TextEditor;
Exec=kern %F
Icon=kern
Terminal=false
StartupNotify=true
StartupWMClass=io.github.verycareful.kern
