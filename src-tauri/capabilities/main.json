{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Capability for the main window",
  "windows": ["main", "doc-*"],
  "permissions": [
    "core:default",
    "kernkraft-tauri:default",
    "allow-settings-get",
    "allow-settings-set",
    "allow-pins-get",
    "allow-pin",
    "allow-unpin",
    "allow-pins-reorder",
    "allow-recents-get",
    "allow-recent-touch",
    "allow-prune",
    "allow-store-errors-take",
    "allow-open-paths",
    "allow-doc-opened",
    "allow-doc-closed",
    "allow-open-pending-take",
    "allow-detach-doc",
    "allow-move-doc-to-main",
    "allow-adopted",
    "allow-confirm-close",
    "allow-fm1-status",
    "allow-default-fm-status",
    "allow-make-default-fm"
  ]
}
