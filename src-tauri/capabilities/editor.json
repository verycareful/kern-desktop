{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "editor",
  "description": "Capability for the editor windows: tabs of documents, a folder tree with its file operations, and the places strip. Of kernkraft's commands what that page calls: listing, watching, text open, save and check, the theme, volumes to look at, what a pinned or recent entry is, where a link points, creating, renaming, the name search, a terminal and https links; copies and moves through drop_start_op and the Trash and delete for good of given items through remove_start_op, each starting only those operations (cancel_op, answer_conflict, undo_state, same_filesystem with them); the file clipboard; its tabs kept for the next launch (session_put); and the report of a rename or move it did, so a tab open on the file follows it (doc_moved). Never start_op, which can also empty the Trash or purge it, and no mount, launcher, default-application or Trash listing command",
  "windows": ["editor-*"],
  "permissions": [
    "core:default",
    "kernkraft-tauri:allow-list-dir",
    "kernkraft-tauri:allow-entry-of",
    "kernkraft-tauri:allow-watch-dir",
    "kernkraft-tauri:allow-unwatch-dir",
    "kernkraft-tauri:allow-user-dirs",
    "kernkraft-tauri:allow-text-open",
    "kernkraft-tauri:allow-text-save",
    "kernkraft-tauri:allow-text-check",
    "kernkraft-tauri:allow-theme-get",
    "kernkraft-tauri:allow-volumes-list",
    "kernkraft-tauri:allow-volumes-problems-take",
    "kernkraft-tauri:allow-open-default",
    "kernkraft-tauri:allow-open-url",
    "kernkraft-tauri:allow-create-dir",
    "kernkraft-tauri:allow-create-file",
    "kernkraft-tauri:allow-rename",
    "kernkraft-tauri:allow-open-terminal",
    "kernkraft-tauri:allow-search",
    "kernkraft-tauri:allow-mime-of",
    "kernkraft-tauri:allow-same-filesystem",
    "kernkraft-tauri:allow-cancel-op",
    "kernkraft-tauri:allow-answer-conflict",
    "kernkraft-tauri:allow-undo-state",
    "allow-settings-get",
    "allow-settings-set",
    "allow-layout-get",
    "allow-pins-get",
    "allow-pin",
    "allow-unpin",
    "allow-pin-editor-set",
    "allow-pins-reorder",
    "allow-recents-get",
    "allow-recent-touch",
