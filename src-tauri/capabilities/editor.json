{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "editor",
  "description": "Capability for the editor windows: tabs of documents, a folder tree and the places strip. Of kernkraft's commands only what that page calls (listing, watching, text open, save and check, the theme, volumes to look at, what a pinned or recent entry is, where a link points, and the copy or move of files dropped on the tree: same_filesystem, drop_start_op which starts only a copy or a move, cancel_op, answer_conflict, undo_state); and its tabs kept for the next launch (session_put); no trash, rename, create, mount, launcher or default-application command, and not start_op, which can delete for good or empty the Trash",
  "windows": ["editor-*"],
  "permissions": [
    "core:default",
    "kernkraft-tauri:allow-list-dir",
    "kernkraft-tauri:allow-entry-of",
    "kernkraft-tauri:allow-watch-dir",
    "kernkraft-tauri:allow-unwatch-dir",
    "kernkraft-tauri:allow-user-dirs",
    "kernkraft-tauri:allow-text-open",
    "kernkraft-tauri:allow-text-save",
    "kernkraft-tauri:allow-text-check",
    "kernkraft-tauri:allow-theme-get",
    "kernkraft-tauri:allow-volumes-list",
    "kernkraft-tauri:allow-volumes-problems-take",
    "kernkraft-tauri:allow-open-default",
    "kernkraft-tauri:allow-open-url",
    "kernkraft-tauri:allow-mime-of",
    "kernkraft-tauri:allow-same-filesystem",
    "kernkraft-tauri:allow-cancel-op",
    "kernkraft-tauri:allow-answer-conflict",
    "kernkraft-tauri:allow-undo-state",
    "allow-settings-get",
    "allow-settings-set",
    "allow-layout-get",
    "allow-pins-get",
    "allow-pin",
    "allow-unpin",
    "allow-pin-editor-set",
    "allow-pins-reorder",
    "allow-recents-get",
    "allow-recent-touch",
    "allow-recent-remove",
    "allow-show-in-folder",
    "allow-hand-doc",
    "allow-hand-refused",
    "allow-adopted",
    "allow-refuse-adoption",
    "allow-prune",
    "allow-store-errors-take",
    "allow-file-identity",
    "allow-link-target",
    "allow-open-paths",
    "allow-doc-opened",
    "allow-doc-closed",
    "allow-open-pending-take",
    "allow-doc-open-elsewhere",
    "allow-detach-doc",
    "allow-open-editor",
    "allow-open-settings",
    "allow-restart-abandon",
    "allow-session-put",
    "allow-confirm-close",
    "allow-dnd-target",
    "allow-drop-start-op"
  ]
}
