{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "io.github.verycareful.kern",
  "mainBinaryName": "kern",
  "identifier": "io.github.verycareful.kern",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Kern",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 560,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "assetProtocol": { "enable": true, "scope": ["$CACHE/thumbnails/**"] },
      "csp": "default-src 'self' ipc: http://ipc.localhost; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: blob: data:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "icon": [
      "icons/512x512.png",
      "icons/16x16.png",
      "icons/24x24.png",
      "icons/32x32.png",
      "icons/48x48.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/256x256.png"
    ],
    "publisher": "Sricharan Suresh",
    "copyright": "Copyright (c) 2026 Sricharan Suresh (github.com/verycareful)",
    "license": "AGPL-3.0-or-later",
    "category": "Utility",
    "shortDescription": "Browse, organise and edit your files",
    "longDescription": "Kern is a file manager and text editor in one window. Folders and documents open as tabs beside each other, every file is read and written in place, and Kern never uses the network.",
    "linux": {
      "deb": {
        "desktopTemplate": "linux/io.github.verycareful.kern.desktop",
        "section": "utils",
        "files": {
          "/usr/share/metainfo/io.github.verycareful.kern.metainfo.xml": "linux/io.github.verycareful.kern.metainfo.xml",
          "/usr/share/icons/hicolor/scalable/apps/kern.svg": "icons/kern.svg",
          "/usr/share/doc/io-github-verycareful-kern/copyright": "../LICENSE"
        }
      },
      "appimage": {
        "files": {
          "/usr/share/metainfo/io.github.verycareful.kern.metainfo.xml": "linux/io.github.verycareful.kern.metainfo.xml",
          "/usr/share/icons/hicolor/scalable/apps/kern.svg": "icons/kern.svg",
          "/usr/share/doc/io-github-verycareful-kern/copyright": "../LICENSE"
        }
      }
    }
  }
}
